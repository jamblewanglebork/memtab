{
  "manifest_version": 3,
  "name": "MemTab — Your browser, remembered",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Find tabs, bookmarks, and browsing history by meaning. Private local search and smart workspace organization.",
  "permissions": ["tabs", "tabGroups", "storage", "offscreen", "scripting", "bookmarks", "history", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Search MemTab (Alt+K)", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}},
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "options_page": "library.html#settings",
  "commands": {"_execute_action": {"suggested_key": {"default": "Alt+K", "mac": "Alt+K"}, "description": "Search your browser memory"}},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["extractor.js"], "run_at": "document_idle"}],
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"},
  "incognito": "not_allowed"
}
